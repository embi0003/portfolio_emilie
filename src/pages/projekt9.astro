---
import MainLayout from "../layouts/MainLayout.astro";
import Heading from "../components/Heading.astro";
import Text from "../components/Text.astro";
import Link from "../components/Link.astro";
import Kontakt from "../components/Kontakt.astro";
import Deler from "../components/Deler.astro";
---

<MainLayout title="Redesign af Børnebiffen - UX/UI">

<main class="container mx-auto px-4">

  <!-- 1. HERO -->
  <section class="py-14 md:py-12 mt-10">
    <div class="max-w-6xl mx-auto px-4">

      <p class="text-xs uppercase tracking-[0.3em] text-accent">
        Redesign· UX/UI
      </p>

      <Heading
        htmlheading="h1"
        size="large"
        font="sans"
        stylingclasses="mt-4"
      >
        Redesign af Børnebiffen
      </Heading>

      <Text stylingclasses="mt-5 leading-8 text-text max-w-4xl">
        Som en del af et gruppeprojekt på multimediedesigneruddannelsen lavede jeg et redesign af Børnebiffens hjemmeside med fokus på at gøre oplevelsen mere børnevenlig, intuitiv og visuelt engagerende.
      </Text>

    </div>
  </section>

  <!-- 2. CONTEXT STRIP -->
  <section class="border-t border-b border-border py-5 md:py-6">
    <div class="max-w-6xl mx-auto px-4">

      <div class="flex flex-wrap items-center gap-x-8 gap-y-2 text-sm text-text/80">

        <p class="leading-none">
          <span class="text-accent uppercase tracking-[0.2em] text-xs">Rolle</span>
          <span class="ml-2">UX/UI-designer</span>
        </p>

        <p class="leading-none">
          <span class="text-accent uppercase tracking-[0.2em] text-xs">Medie</span>
          <span class="ml-2">Børnebiffen</span>
        </p>

        <p class="leading-none">
          <span class="text-accent uppercase tracking-[0.2em] text-xs">År</span>
          <span class="ml-2">2025</span>
        </p>

      </div>

    </div>
  </section>

  <!-- 3. FEATURE STORY -->
  <section class="py-20">
    <div class="max-w-6xl mx-auto px-4">

      <p class="text-xs uppercase tracking-[0.3em] text-accent mb-6">
        Redesignproces
      </p>

      <Text stylingclasses="mt-5 leading-8 text-text max-w-5xl mb-8">
        Målet med redesignet var at skabe en mere overskuelig og levende hjemmeside, der både appellerede til børn og deres forældre. Jeg arbejdede med UX/UI-principper, struktur, indhold og visuel fortælling for at gøre oplevelsen mere klar og engagerende.
      </Text>

      <div class="grid grid-cols-1 md:grid-cols-[1.2fr_auto_1.2fr] gap-8 md:gap-12 items-center mt-24">

        <!-- Video 1 -->
        <div class="flex flex-col">
          <div class="overflow-hidden">
            <video
              autoplay
              muted
              loop
              playsinline
              class="w-full block"
            >
              <source src="/img/bornebiffen1.mp4" type="video/mp4" />
            </video>
          </div>
          <div class="mt-5 text-center">
            <Link
              href="https://www.bornebiffen.dk/"
              target="_blank"
              variant="textlink"
              size="small"
            >
              Besøg original hjemmeside
            </Link>
          </div>
        </div>

        <!-- Pil -->
        <div class="flex justify-center items-center">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-6 h-6 md:w-8 md:h-8 text-accent rotate-90 md:rotate-0 flex-shrink-0"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"
            />
          </svg>
        </div>

        <!-- Video 2 -->
        <div class="flex flex-col">
          <div class="overflow-hidden">
            <video
              autoplay
              muted
              loop
              playsinline
              class="w-full block"
            >
              <source src="/img/bornebiffen2.mp4" type="video/mp4" />
            </video>
          </div>
          <div class="mt-5 text-center">
            <Link
              href="https://boernebiffen2.netlify.app/"
              target="_blank"
              variant="textlink"
              size="small"
            >
              Se hele redesignet her
            </Link>
          </div>
        </div>

      </div>

    </div>
  </section>

  <Deler ws="m" />

  <!-- KONTAKT -->
  <Kontakt
    title="Skal vi tage en kop kaffe?"
    text="Hvis du er nået hertil og tænker 'hmm, Emilie, hun kunne godt være et match', så tøv ikke med at række ud! Jeg er altid klar på at tage en kop kaffe og finde ud af, hvordan vi kan skabe noget fedt sammen."
    ctaLabel="Kontakt mig her"
    ctaHref="/kontakt"
    imageSrc="/img/telefon.webp"
  />

</main>

</MainLayout>
