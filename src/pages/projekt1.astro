---
import MainLayout from "../layouts/MainLayout.astro";
import Heading from "../components/Heading.astro";
import Text from "../components/Text.astro";
import Kontakt from "../components/Kontakt.astro";
import Deler from "../components/Deler.astro";

---

<MainLayout title="Femina – Artikelserie">

<main class="container mx-auto px-4">

 
 <!-- 1. HERO -->
<section class="py-14 md:py-12 mt-10">
  <div class="max-w-6xl mx-auto px-4">

    <p class="text-xs uppercase tracking-[0.3em] text-accent">
      Artikelserie · Journalistik
    </p>

    <Heading
      htmlheading="h1"
      size="large"
      font="sans"
      stylingclasses="mt-4"
    > God gynækologisk undersøgelse
    </Heading>

    <Text stylingclasses="mt-5 leading-8 text-text max-w-4xl">
      En artikelserie, der afdækker flere kvinders oplevelser i forbindelse med gynækologiske undersøgelser og sætter fokus på at skabe mere respekt omkring kvinders underliv. Lavet som en del af mit journalistiske praktikforløb på Femina.
    </Text>

  </div>
</section>

<!-- 2. CONTEXT STRIP (tight version) -->
<section class="border-t border-b border-border py-5 md:py-6">
  <div class="max-w-6xl mx-auto px-4">

    <div class="flex flex-wrap items-center gap-x-8 gap-y-2 text-sm text-text/80">

      <p class="leading-none">
        <span class="text-accent uppercase tracking-[0.2em] text-xs">Rolle</span>
        <span class="ml-2">Journalist</span>
      </p>

      <p class="leading-none">
        <span class="text-accent uppercase tracking-[0.2em] text-xs">Medie</span>
        <span class="ml-2">Femina</span>
      </p>

      <p class="leading-none">
        <span class="text-accent uppercase tracking-[0.2em] text-xs">År</span>
        <span class="ml-2">2021</span>
      </p>

    </div>

  </div>
</section>

  <!-- 3. FEATURE STORY -->
 <section class="py-20">
  <div class="max-w-6xl mx-auto px-4">

    <p class="text-xs uppercase tracking-[0.3em] text-accent mb-4">
      Uddrag
    </p>

    <div class="max-w-4xl space-y-10">

      <!-- CITAT / UDDRAG -->
      <div>
        <Text stylingclasses="text-xl leading-9 italic text-text">
          “En rødglødende smerte skar gennem mit underliv. Jeg skreg af smerte, og smerten blev ved bagefter. Han reagerede, som om det var en stor overraskelse, og at det var meget mærkeligt, at jeg havde ondt.”
        </Text>
      </div>

      <!-- FORKLARENDE TEKST -->
      <div class="max-w-4xl space-y-6">
        <Text stylingclasses="leading-8 text-text">
          Artiklerne undersøger et mønster, hvor mange kvinder ofte oplever, at deres smerte og ubehag under gynækologiske undersøgelser bliver ignoreret eller nedtonet af deres gynækolog.
          Dette kan føre til, at kvinderne føler sig usikre, utrygge og ikke bliver taget alvorligt i deres oplevelser.
        </Text>
      </div>

    </div>

  </div>
</section>

  <!-- 4. ARTIKLER I SERIEN -->
  <section class="pb-24">
    <div class="max-w-6xl mx-auto px-4">

      <Heading
        htmlheading="h2"
        size="medium"
        font="sans"
        stylingclasses="mb-10"
      >
        Læs artiklerne her
      </Heading>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">

        <!-- CARD 1 -->
        <a
          href="https://www.femina.dk/agenda/samfund/jordemoder-man-skal-kunne-gaa-fra-en-gynaekologisk-undersoegelse-med-sin-sjael"
          target="_blank"
          rel="noopener noreferrer"
          class="group block transition-all duration-300 hover:-translate-y-1"
        >
          <div class="overflow-hidden rounded-xl">
            <img
              src="/img/jordemoder.webp"
              class="w-full aspect-[4/3] object-cover transition duration-500 group-hover:scale-105"
            />
          </div>

          <h3 class="mt-5 font-heading text-xl group-hover:text-accent transition-colors duration-300">
            Jordemoder: ”Man skal kunne gå fra en gynækologisk undersøgelse med sin sjæl intakt”
          </h3>

          <p class="mt-4 text-sm uppercase tracking-[0.15em] text-accent">
            Læs artiklen →
          </p>
        </a>

        <!-- CARD 2 -->
        <a
          href="https://www.femina.dk/sundhed/krop-velvaere/det-er-paa-tide-der-kommer-mere-respekt-omkring-kvinders-underliv"
          target="_blank"
          rel="noopener noreferrer"
          class="group block transition-all duration-300 hover:-translate-y-1"
        >
          <div class="overflow-hidden rounded-xl">
            <img
              src="/img/artikel2.webp"
              class="w-full aspect-[4/3] object-cover transition duration-500 group-hover:scale-105"
            />
          </div>

          <h3 class="mt-5 font-heading text-xl group-hover:text-accent transition-colors duration-300">
            ”Det er på tide, at der kommer mere respekt omkring kvinders underliv”
          </h3>

          <p class="mt-10 text-sm uppercase tracking-[0.15em] text-accent">
            Læs artiklen →
          </p>
        </a>

        <!-- CARD 3 -->
        <a
          href="https://www.femina.dk/sundhed/krop-velvaere/det-var-lyden-af-saksen-der-pludselig-klippede-inden-i-mig-der-var-det"
          target="_blank"
          rel="noopener noreferrer"
          class="group block transition-all duration-300 hover:-translate-y-1"
        >
          <div class="overflow-hidden rounded-xl">
            <img
              src="/img/maja.webp"
              class="w-full aspect-[4/3] object-cover transition duration-500 group-hover:scale-105"
            />
          </div>

          <h3 class="mt-5 font-heading text-xl group-hover:text-accent transition-colors duration-300">
            ”Det var lyden af saksen, der pludselig klippede inden i mig, der var det værste”
          </h3>

          <p class="mt-4 text-sm uppercase tracking-[0.15em] text-accent">
            Læs artiklen →
          </p>
        </a>

      </div>

    </div>
  </section>

  

   <Deler ws="m" />

  <!-- KONTAKT -->
   <Kontakt 
  title="Skal vi tage en kop kaffe?"
  text="Hvis du er nået hertil og tænker 'hmm, Emilie, hun kunne godt være et match', så tøv ikke med at række ud! Jeg er altid klar på at tage en kop kaffe og finde ud af, hvordan vi kan skabe noget fedt sammen."
  ctaLabel="Kontakt mig her"
  ctaHref="/kontakt"
  imageSrc="/img/telefon.webp"
/>

</main>

</MainLayout>