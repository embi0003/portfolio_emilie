---
import MainLayout from "../layouts/MainLayout.astro";
import Heading from "../components/Heading.astro";
import Text from "../components/Text.astro";
import Link from "../components/Link.astro";
import Kontakt from "../components/Kontakt.astro";
import Deler from "../components/Deler.astro";
import ProjectNav from "../components/ProjectNav.astro";
---

<MainLayout title="Redesign af Hjælp Din Næste - UX/UI">

<main class="container mx-auto px-4">

 
 <!-- 1. HERO -->
<section class="py-14 md:py-12 mt-10">
  <div class="max-w-6xl mx-auto px-4">

    <p class="text-xs uppercase tracking-[0.3em] text-accent">
      Redesign· UX/UI
    </p>

    <Heading
      htmlheading="h1"
      size="large"
      font="sans"
      stylingclasses="mt-4"
    > Redesign af Hjælp Din Næste
    </Heading>

    <Text stylingclasses="mt-5 leading-8 text-text max-w-4xl">
     På mit afsluttende eksamensprojekt på multimediedesigneruddannelsen lavede jeg sammen med min gruppe et komplet redesign af Hjælp Din Næstes hjemmeside.
    </Text>

  </div>
</section>

<!-- 2. CONTEXT STRIP (tight version) -->
<section class="border-t border-b border-border py-5 md:py-6">
  <div class="max-w-6xl mx-auto px-4">

    <div class="flex flex-wrap items-center gap-x-8 gap-y-2 text-sm text-text/80">

      <p class="leading-none">
        <span class="text-accent uppercase tracking-[0.2em] text-xs">Rolle</span>
        <span class="ml-2">UX/UI-designer</span>
      </p>

      <p class="leading-none">
        <span class="text-accent uppercase tracking-[0.2em] text-xs">Medie</span>
        <span class="ml-2">Bakkefest</span>
      </p>

      <p class="leading-none">
        <span class="text-accent uppercase tracking-[0.2em] text-xs">År</span>
        <span class="ml-2">2026</span>
      </p>

    </div>

  </div>
</section>

 <!-- 3. FEATURE STORY -->
<section class="py-20">
  <div class="max-w-6xl mx-auto px-4">

    <p class="text-xs uppercase tracking-[0.3em] text-accent mb-6">
      Redesignproces
    </p>

    <Text stylingclasses="mt-5 leading-8 text-text max-w-5xl mb-8">
    Formålet med redesignprocessen var at forbedre den visuelle identitet og navigationen på hjemmesiden, så brugerne nemmere kunne finde de informationer, de søgte. Jeg arbejdede med UX/UI-designprincipper, herunder brugerundersøgelser, wireframing og prototyping for at skabe en mere intuitiv og brugervenlig oplevelse for besøgende på hjemmesiden. Projektet fik karakteren 12, og organisationen har udtrykt ønske om at bruge designet.
    </Text>

    <div class="grid grid-cols-1 md:grid-cols-[1.2fr_auto_1.2fr] gap-8 md:gap-12 items-center mt-24">

      <!-- Video 1 -->
      <div class="flex flex-col">
        <div class="overflow-hidden">
          <video
            autoplay
            muted
            loop
            playsinline
            class="w-full block"
          >
            <source src="/img/foer.mp4" type="video/mp4" />
          </video>
        </div>
        <div class="mt-5 text-center">
          <Link
            href="https://hjaelpdinnaeste.org/"
            target="_blank"
            variant="textlink"
            size="small"
          >
            Besøg original hjemmeside
          </Link>
        </div>
      </div>

      <!-- Pil -->
      <div class="flex justify-center items-center">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="w-6 h-6 md:w-8 md:h-8 text-accent rotate-90 md:rotate-0 flex-shrink-0"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"
          />
        </svg>
      </div>

      <!-- Video 2 -->
      <div class="flex flex-col">
        <div class="overflow-hidden">
          <video
            autoplay
            muted
            loop
            playsinline
            class="w-full block"
          >
            <source src="/img/efter.mp4" type="video/mp4" />
          </video>
        </div>
        <div class="mt-5 text-center">
          <Link
            href="https://hjaelp-din-naeste-copy.netlify.app/"
            target="_blank"
            variant="textlink"
            size="small"
          >
            Se hele redesignet her
          </Link>
        </div>
      </div>

    </div>

  </div>
</section>

   <ProjectNav prevHref="/projekt6" nextHref="/projekt8" />

  <Deler ws="m" />

  <!-- KONTAKT -->
   <Kontakt 
  title="Skal vi tage en kop kaffe?"
  text="Hvis du er nået hertil og tænker 'hmm, Emilie, hun kunne godt være et match', så tøv ikke med at række ud! Jeg er altid klar på at tage en kop kaffe og finde ud af, hvordan vi kan skabe noget fedt sammen."
  ctaLabel="Kontakt mig her"
  ctaHref="/kontakt"
  imageSrc="/img/telefon.webp"
/>

</main>

</MainLayout>