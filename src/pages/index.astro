---
import MainLayout from "../layouts/MainLayout.astro";
import Link from "../components/Link.astro";
import Heading from "../components/Heading.astro";
import Hero from "../components/Hero.astro";
import Card from "../components/Card.astro";
import CvTimelineNew from "../components/CvTimelineNew.astro";
import Kontakt from "../components/Kontakt.astro";
import Deler from "../components/Deler.astro";

---
<MainLayout title="Forside">

	<main class="w-full max-w-full overflow-x-hidden">

		<!-- HERO -->
		<section class="w-full">
			<Hero />
		</section>


		<Deler ws="m" />


		<!-- UDVALGTE PROJEKTER -->
		<section class="w-full bg-accent-soft py-12 intersect:animate-fade-up animate-once animate-duration-[1500ms]">

			<div class="w-full max-w-6xl mx-auto px-4">

				<div class="mb-8 text-left">
					<Heading
						htmlheading="h2"
						size="medium"
						font="sans"
						stylingclasses="uppercase tracking-[0.35em] text-3xl md:text-4xl text-text"
					>
						Udvalgte projekter
					</Heading>
				</div>


				<!-- PROJEKTER -->
				<div class="grid grid-cols-1 gap-6 md:grid-cols-3 md:[grid-auto-rows:1fr]">

					<Card 
						href="/projekter"
						category="UX/UI" 
						title="Redesign af NGO'en Hjælp Din Næste"
						description="Et komplet redesign af Hjælp Din Næstes hjemmeside med fokus på at forbedre den visuelle identitet og navigationen. Afsluttende eksamensprojekt på multimediedesigneruddannelsen."
						class="w-full intersect:animate-fade-left animate-once animate-duration-[1500ms]"
						linkText="Læs mere"
						linkHref="/projekter"
					/>

					<Card 
						href="/projekt6"
						category="Podcast" 
						title="Podcast om kommunikation"
						description="Think About It er en podcast, der går i dybden med områder inden for kommunikation med forskellige gæster fra branchen."
						class="w-full intersect:animate-fade-left animate-once animate-duration-[1500ms]"
						linkText="Læs mere"
						linkHref="/projekter"
					/>

					<Card 
						href="/projekt2"
						category="SoMe" 
						title="Minikampagne for Digitaliseringsstyrelsen"
						description="En minikampagne målrettet Facebook og Instagram med fokus på at øge engagementet på Digitaliseringsstyrelsens kanaler."
						class="w-full intersect:animate-fade-left animate-once animate-duration-[1500ms]"
						linkText="Læs mere"
						linkHref="/projekter"
					/>

				</div>


				<div class="mt-12 text-center">
					<Link
						href="/projekter"
						variant="primary"
						size="small"
					>
						Se alle projekter
					</Link>
				</div>

			</div>

		</section>


		<Deler ws="m" />


		<!-- CV -->
		<section class="w-full max-w-full overflow-hidden">
			<CvTimelineNew />
		</section>


		<Deler ws="m" />


		<!-- KONTAKT -->
		<section class="w-full max-w-full">
			<Kontakt 
				title="Skal vi tage en kop kaffe?"
				text="Hvis du er nået hertil og tænker 'hmm, Emilie, hun kunne godt være et match', så tøv ikke med at række ud! Jeg er altid klar på at tage en kop kaffe og finde ud af, hvordan vi kan skabe noget fedt sammen."
				ctaLabel="Kontakt mig her"
				ctaHref="/kontakt"
				imageSrc="/img/telefon.webp"
			/>	
		</section>

	</main>

</MainLayout>