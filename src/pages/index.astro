---
import MainLayout from "../layouts/MainLayout.astro";
import Link from "../components/Link.astro";
import Heading from "../components/Heading.astro";
import Text from "../components/Text.astro";
import Hero from "../components/Hero.astro";
import Card from "../components/Card.astro";
import CvTimelineNew from "../components/CvTimelineNew.astro";
import Kontakt from "../components/Kontakt.astro";
import Deler from "../components/Deler.astro";
---
<MainLayout title="Forside">
	<main class="container mx-auto px-4">
		<Hero/>

		<Deler ws="m" />

		<section class="full-bleed bg-accent-soft py-12 intersect:animate-fade-up animate-once animate-duration-[1500ms]">
			<div class="container mx-auto px-4 md:py-10">
				<div class="max-w-6xl mx-auto">
					<div class="mb-10 intersect:animate-fade-right animate-once animate-duration-[1500ms]">
						<Heading htmlheading="h2" size="medium" font="sans" stylingclasses="uppercase tracking-[0.3em] text-2xl md:text-3xl">
							Udvalgte projekter
						</Heading>
						<Text stylingclasses="max-w-5xl text-text leading-7">
							Her er et udpluk af projekter, der repræsenterer mit arbejde med journalistik og multimediedesign. Se flere projekter og cases på min samlede projektside.
						</Text>
					</div>

					<div class="grid gap-6 md:grid-cols-3 md:[grid-auto-rows:1fr]">
						<Card 
							href="/projekter"
							category="UX/UI" 
							title="Redesign af NGO'en Hjælp Din Næste"
							description="Et komplet redesign af Hjælp Din Næstes hjemmeside med fokus på at forbedre den visuelle identitet og navigationen. Afsluttende eksamensprojekt på multimediedesigneruddannelsen."
							class="intersect:animate-fade-left animate-once animate-duration-[1500ms]"
							linkText="Læs mere"
							linkHref="/projekter"
						/>

						<Card 
							href="/projekt6"
							category="Podcast" 
							title="Podcast om kommunikation"
							description="Think About It er en podcast, der går i dybden med områder inden for kommunikation med forskellige gæster fra branchen."
							class="intersect:animate-fade-left animate-once animate-duration-[1500ms]"
							linkText="Læs mere"
							linkHref="/projekter"
						/>

						<Card 
							href="/projekt2"
							category="SoMe" 
							title="Minikampagne for Digitaliseringsstyrelsen"
							description="En minikampagne målrettet Facebook og Instagram med fokus på at øge engagementet på Digitaliseringsstyrelsens kanaler."
							class="intersect:animate-fade-left animate-once animate-duration-[1500ms]"
							linkText="Læs mere"
							linkHref="/projekter"
						/>
					</div>

					<div class="mt-12 text-center">
					
    				<Link href='/projekter' variant='primary' size='small'> Se alle projekter </Link>
					</div>
				</div>
			</div>
		</section>
		
		<!-- <Deler ws="m" />

		<section class="py-12 md:py-16 intersect:animate-fade-up animate-once animate-duration-[1500ms]">
			<div class="max-w-6xl mx-auto px-4 md:px-0 intersect:animate-fade-right animate-once animate-duration-[1500ms]">
				<div class="mb-10">
					<Heading htmlheading="h2" size="medium" font="sans" stylingclasses="uppercase tracking-[0.3em] text-2xl md:text-3xl mb-4">
						Mød mig her
					</Heading>
					<Text stylingclasses="max-w-2xl text-text leading-7">
						Jeg har lavet en lille video, der skal give et større indblik i, hvem jeg er.
					</Text>
				</div>

				<div class="aspect-video bg-surface border border-border rounded-[2rem] overflow-hidden intersect:animate-fade-left animate-once animate-duration-[1500ms]">
					<!-- Video embed placeholder -->
					<!-- <div class="w-full h-full flex items-center justify-center text-text">
						<p class="text-xl">Tilføj dit videoindhold her</p>
					</div>
				</div>
			</div>
		</section> -->

		<Deler ws="m" />

<CvTimelineNew />

<Deler ws="m" />

<Kontakt 
  title="Skal vi tage en kop kaffe?"
  text="Hvis du er nået hertil og tænker 'hmm, Emilie, hun kunne godt være et match', så tøv ikke med at række ud! Jeg er altid klar på at tage en kop kaffe og finde ud af, hvordan vi kan skabe noget fedt sammen."
  ctaLabel="Kontakt mig her"
  ctaHref="/kontakt"
  imageSrc="/img/telefon.webp"
/>	

	</main>

</MainLayout>
