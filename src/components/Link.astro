---
interface Props {
  href?: string;
  target?: string;
  download?: boolean | string;
  variant?: "textlink" | "primary" | "secondary";
  size?: "default" | "large" | "medium" | "small";
}

// Henter parametrene fra Astro.props
const { href="#", target="_self", download = false, variant= "textlink", size = "default" } = Astro.props as Props; 
 
//Definer den styling (Tailwind classes, der gør sig gældende for alle links
const linkStyling = "rounded-lg transition-all duration-300 font-semibold uppercase transform hover:scale-102"; 
//Definer den styling (Tailwind classes, der gør sig gældende for de forskellige varianter 
const variantClasses = {
"textlink": "underline text-accent",
"primary": "inline-block border-2 px-8 py-4 border-accent bg-accent text-white hover:bg-accent-soft hover:text-accent",
"secondary": "inline-block border-2 px-16 py-4 border-accent bg-accent-soft text-accent hover:bg-accent hover:text-white"
};
 
//Definer den styling (Tailwind classes), der gør sig gældende for de forskelligeog størrelser.
const sizeClasses = {
"default": "text-default", 
"large": "text-4xl",
"medium": "text-xl",
"small": "text-large",
"xsmall": "text-sm"
};
---
<!--Sæt classes for den pågældende knap sammen ved hjælp af Astros class:list -->
<a href={href} target={target} download={download ? "" : undefined} class:list={[linkStyling, variantClasses[variant], sizeClasses[size]]}><slot /></a>