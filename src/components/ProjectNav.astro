---
interface Props {
  prevHref?: string;
  prevLabel?: string;
  nextHref?: string;
  nextLabel?: string;
}

const {
  prevHref = "/projekter",
  prevLabel = "Tilbage",
  nextHref = "/projekter",
  nextLabel = "Næste",
} = Astro.props;
---

<div class="mt-8 border-t border-border pt-6 sm:mt-10 sm:pt-8 md:mt-14">
  <div class="mx-auto flex max-w-6xl flex-col gap-3 px-4 sm:flex-row sm:items-center sm:justify-between sm:gap-4">
    <a
      href={prevHref}
      class="inline-flex items-center justify-between gap-2 rounded-full border border-border px-4 py-3 text-sm uppercase tracking-[0.2em] text-text/80 transition hover:border-accent hover:text-accent"
    >
      <span aria-hidden="true">←</span>
      <span>{prevLabel}</span>
    </a>

    <a
      href={nextHref}
      class="inline-flex items-center justify-between gap-2 rounded-full border border-border px-4 py-3 text-sm uppercase tracking-[0.2em] text-text/80 transition hover:border-accent hover:text-accent"
    >
      <span>{nextLabel}</span>
      <span aria-hidden="true">→</span>
    </a>
  </div>
</div>
