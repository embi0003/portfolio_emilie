<header class="border-b border-border bg-bg/95 backdrop-blur-sm">
  <div class="mx-auto max-w-6xl px-4 py-3 sm:px-6 sm:py-4">
    <div class="flex flex-wrap items-center justify-between gap-3 md:flex-nowrap">
      <a
        href="/"
        class="flex-1 text-left text-lg font-bold uppercase tracking-[0.2em] text-accent transition hover:text-text sm:text-xl md:text-2xl"
      >
        Emilie Rose
      </a>

      <button
        id="menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-nav"
        class="shrink-0 flex h-11 w-11 cursor-pointer items-center justify-center rounded-full border border-border bg-surface text-text transition hover:border-accent hover:text-accent md:hidden"
      >
        <span class="sr-only">Åbn menu</span>
        <span class="flex flex-col items-center gap-1.5">
          <span class="block h-0.5 w-5 bg-current"></span>
          <span class="block h-0.5 w-5 bg-current"></span>
          <span class="block h-0.5 w-5 bg-current"></span>
        </span>
      </button>

      <nav class="order-3 hidden w-full md:order-none md:ml-auto md:block md:w-auto">
        <ul class="flex items-center gap-6 pt-2 text-lg font-heading uppercase tracking-[0.1em] text-text md:pt-0">
          <li>
            <a href="/projekter" class="transition hover:text-accent">
              Projekter
            </a>
          </li>
          <li>
            <a href="/om-mig" class="transition hover:text-accent">
              Om mig
            </a>
          </li>
          <li>
            <a href="/kontakt" class="transition hover:text-accent">
              Kontakt
            </a>
          </li>
        </ul>
      </nav>
    </div>

    <nav id="mobile-nav" class="mt-3 hidden w-full rounded-2xl border border-border bg-surface/95 p-4 shadow-lg md:hidden">
      <ul class="flex w-full flex-col gap-2 text-base font-heading uppercase tracking-[0.16em] text-text">
        <li>
          <a href="/projekter" class="block rounded-lg px-2 py-3 transition hover:bg-accent-soft hover:text-accent">
            Projekter
          </a>
        </li>
        <li>
          <a href="/om-mig" class="block rounded-lg px-2 py-3 transition hover:bg-accent-soft hover:text-accent">
            Om mig
          </a>
        </li>
        <li>
          <a href="/kontakt" class="block rounded-lg px-2 py-3 transition hover:bg-accent-soft hover:text-accent">
            Kontakt
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script is:inline>
  const toggleButton = document.getElementById('menu-toggle');
  const mobileNav = document.getElementById('mobile-nav');

  if (toggleButton && mobileNav) {
    const setOpen = (open) => {
      mobileNav.classList.toggle('hidden', !open);
      toggleButton.setAttribute('aria-expanded', String(open));
    };

    toggleButton.addEventListener('click', () => {
      const isOpen = toggleButton.getAttribute('aria-expanded') === 'true';
      setOpen(!isOpen);
    });

    mobileNav.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });

    document.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      if (!mobileNav.contains(target) && !toggleButton.contains(target)) {
        setOpen(false);
      }
    });

    window.addEventListener('resize', () => {
      if (window.innerWidth >= 768) {
        setOpen(false);
      }
    });
  }
</script>