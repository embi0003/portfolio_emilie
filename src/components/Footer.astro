---
interface Props {
  logoText?: string;
  email?: string;
  phone?: string;
}

const {
  logoText = "Mit portfolio",
  email = "esc070299@gmail.com",
  phone = "+45 22 46 68 13"
} = Astro.props as Props;
---

<footer class="w-full bg-surface border-t border-border">
  <div class="mx-auto max-w-7xl px-5 py-12 md:py-16">

    <!-- TOP GRID -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10">

      <!-- LOGO / BRAND -->
      <div>
        <h3 class="font-display text-xl md:text-2xl text-text">
          {logoText}
        </h3>

        <p class="mt-3 text-sm text-muted leading-6 max-w-xs">
          Design, udvikling og kreative projekter med fokus på gode oplevelser og stærke idéer.
        </p>
      </div>

      <!-- NAV LINKS -->
      <div>
        <h4 class="font-heading text-sm uppercase tracking-[0.25em] text-muted mb-4">
          Sider
        </h4>

        <ul class="space-y-3 text-text">
          <li><a class="hover:text-accent transition" href="/">Forside</a></li>
          <li><a class="hover:text-accent transition" href="/projekter">Projekter</a></li>
          <li><a class="hover:text-accent transition" href="/om-mig">Om mig</a></li>
          <li><a class="hover:text-accent transition" href="/kontakt">Kontakt</a></li>
        </ul>
      </div>

      <!-- CONTACT INFO -->
      <div>
        <h4 class="font-heading text-sm uppercase tracking-[0.25em] text-muted mb-4">
          Kontakt
        </h4>

        <ul class="space-y-3 text-text">
          <li>
            <a
              href={`mailto:${email}`}
              class="hover:text-accent transition"
            >
              {email}
            </a>
          </li>

          <li>
            <a
              href={`tel:${phone}`}
              class="hover:text-accent transition"
            >
              {phone}
            </a>
          </li>
        </ul>
      </div>

      <!-- SOCIALS -->
      <div>
        <h4 class="font-heading text-sm uppercase tracking-[0.25em] text-muted mb-4">
          Find mig
        </h4>

        <ul class="space-y-3 text-text">
          <li>
            <a
              href="https://www.linkedin.com/in/emilie-rose-s%C3%B8ndergaard-159994180/"
              target="_blank"
              class="hover:text-accent transition"
            >
              LinkedIn
            </a>
          </li>

          <li>
            <a
              href="https://www.instagram.com/emiliers99/"
              target="_blank"
              class="hover:text-accent transition"
            >
              Instagram
            </a>
          </li>
        </ul>
      </div>

    </div>

    <!-- BOTTOM BAR -->
    <div class="mt-12 pt-6 border-t border-border flex flex-col md:flex-row justify-between items-center gap-4">

      <p class="text-xs text-muted">
        © {new Date().getFullYear()} {logoText}. All rights reserved.
      </p>

    
    </div>

  </div>
</footer>