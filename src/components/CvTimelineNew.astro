---
const {
  items = [
    {
      date: "Jan 26",
      company: "Digitalt bureau",
      role: "Junior digital designer",
      description:
        "Arbejdede med kampagner, sociale medier og visuel storytelling for kunder i kultur- og livsstilssektoren."
    },
    {
      date: "Aug 25",
      company: "Nyhedsredaktion",
      role: "Journalistisk assistent",
      description:
        "Producerede artikler, lavede research og deltog i redaktionens daglige nyhedsflow."
    },
    {
      date: "Maj 24",
      company: "Marketing startup",
      role: "Kommunikationspraktikant",
      description:
        "Støttede udviklingen af content- og brandingmateriale til virksomhedens sociale platforme."
    },
    {
      date: "Nov 23",
      company: "Kreativt studio",
      role: "Grafisk designpraktikant",
      description:
        "Designede visuelle layouts, printmaterialer og digitale assets til kunder i rejsebranchen."
    },
    {
      date: "Jun 23",
      company: "Skoleprojekt",
      role: "Projektleder",
      description:
        "Ledede et team på 4 personer i et digitalt kampagneprojekt med fokus på brugeroplevelse og visuelt design."
    },
    {
      date: "Feb 22",
      company: "Studiejob",
      role: "Indholdsassistent",
      description:
        "Skrev nyhedsbreve, opdaterede sociale kanaler og optimerede tekst til digitale kampagner."
    }
  ],
  sectionTitle = "Mit CV på tidslinje",
  sectionText = "Swipe eller brug pilene for at navigere i min erfaring."
} = Astro.props;

const id = `timeline-${Math.random().toString(36).slice(2)}`;
---

<section class="py-20 md:py-28 bg-bg intersect:animate-fade-up animate-once animate-duration-[1500ms]">
  <div class="container mx-auto px-4 max-w-7xl">

    <!-- HEADER (mere luft + større impact) -->
    <div class="mb-10 md:mb-14 text-center">
      <h2 class="font-heading uppercase tracking-[0.35em] text-2xl md:text-4xl text-text">
        {sectionTitle}
      </h2>
      <p class="mt-5 text-muted text-base md:text-lg max-w-3xl mx-auto leading-7">
        {sectionText}
      </p>
    </div>

    <!-- WRAPPER (mere “block”) -->
    <div class="relative overflow-hidden rounded-[3rem] border border-border bg-surface px-5 py-10 md:px-10 md:py-14">

      <!-- FADE -->
      <div class="pointer-events-none absolute left-0 top-0 bottom-0 w-16 bg-gradient-to-r from-surface to-transparent z-10"></div>
      <div class="pointer-events-none absolute right-0 top-0 bottom-0 w-16 bg-gradient-to-l from-surface to-transparent z-10"></div>

      <!-- LABEL -->
      <div class="mb-6 flex justify-between">
        <p class="text-[11px] uppercase tracking-[0.4em] text-muted">Erfaring</p>
        <p class="text-[11px] uppercase tracking-[0.4em] text-muted md:hidden">Swipe</p>
      </div>

      <!-- LEFT -->
      <button
        type="button"
        class="hidden md:flex absolute left-4 top-1/2 -translate-y-1/2 z-20 h-12 w-12 items-center justify-center rounded-full border border-border bg-white shadow-sm hover:bg-accent hover:text-white transition"
        onclick={"document.getElementById('" + id + "').scrollBy({ left: -document.querySelector('#" + id + " article').offsetWidth, behavior: 'smooth' })"}
      >
        ‹
      </button>

      <!-- SCROLL -->
      <div
        id={id}
        class="timeline-scroll flex gap-6 overflow-x-auto scroll-smooth snap-x snap-mandatory"
      >

        {items.map((item) => (
          <article class="snap-start flex-shrink-0 w-full sm:w-1/2 lg:w-1/3">

            <div class="relative rounded-[2.5rem] border border-border bg-white p-6 md:p-8 shadow-sm h-[420px] flex flex-col">

              <!-- TOP -->
              <div class="text-center">
                <p class="text-[11px] uppercase tracking-[0.4em] text-muted">
                  {item.date}
                </p>
                <p class="mt-3 text-lg font-semibold text-text">
                  {item.company}
                </p>
              </div>

              <!-- LINE -->
              <div class="relative my-6">
                <div class="h-[2px] bg-border w-full"></div>
                <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 h-4 w-4 rounded-full bg-accent border-2 border-white shadow"></div>
              </div>

              <!-- CONTENT -->
              <div class="flex-1 rounded-[1.8rem] bg-surface border border-border p-5">
                <p class="text-[12px] uppercase tracking-[0.25em] text-accent font-semibold">
                  {item.role}
                </p>
                <p class="mt-4 text-text leading-7 text-sm md:text-base">
                  {item.description}
                </p>
              </div>

            </div>

          </article>
        ))}

      </div>

      <!-- RIGHT -->
      <button
        type="button"
        class="hidden md:flex absolute right-4 top-1/2 -translate-y-1/2 z-20 h-12 w-12 items-center justify-center rounded-full border border-border bg-white shadow-sm hover:bg-accent hover:text-white transition"
        onclick={"document.getElementById('" + id + "').scrollBy({ left: document.querySelector('#" + id + " article').offsetWidth, behavior: 'smooth' })"}
      >
        ›
      </button>

    </div>
  </div>
</section>

<style>
.timeline-scroll {
  scroll-snap-type: x mandatory;
  scrollbar-width: none;
}

.timeline-scroll::-webkit-scrollbar {
  display: none;
}
</style>