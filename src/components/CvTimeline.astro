---
const {
  items = [
    {
      date: "Jan 26",
      company: "Digitalt bureau",
      role: "Junior digital designer",
      description: "Arbejdede med kampagner, sociale medier og visuel storytelling for kunder i kultur- og livsstilssektoren."
    },
    {
      date: "Aug 25",
      company: "Nyhedsredaktion",
      role: "Journalistisk assistent",
      description: "Producerede artikler, lavede research og deltog i redaktionens daglige nyhedsflow."
    },
    {
      date: "Maj 24",
      company: "Marketing startup",
      role: "Kommunikationspraktikant",
      description: "Støttede udviklingen af content- og brandingmateriale til virksomhedens sociale platforme."
    },
    {
      date: "Nov 23",
      company: "Kreativt studio",
      role: "Grafisk designpraktikant",
      description: "Designede visuelle layouts, printmaterialer og digitale assets til kunder i rejsebranchen."
    },
    {
      date: "Jun 23",
      company: "Skoleprojekt",
      role: "Projektleder",
      description: "Ledede et team på 4 personer i et digitalt kampagneprojekt med fokus på brugeroplevelse og visuelt design."
    },
    {
      date: "Feb 22",
      company: "Studiejob",
      role: "Indholdsassistent",
      description: "Skrev nyhedsbreve, opdaterede sociale kanaler og optimerede tekst til digitale kampagner."
    }
  ],
  sectionTitle = "Mit CV på tidslinje",
  sectionText = "Swipe gennem mine ansættelser, og se flere detaljer i hvert kort. På mobil vises ét element ad gangen – på desktop vises tre samtidig."
} = Astro.props as {
  items?: Array<{ date: string; company: string; role?: string; description: string }>;
  sectionTitle?: string;
  sectionText?: string;
};

const timelineId = `timeline-${Math.random().toString(36).slice(2)}`;
---

<section class="py-6 md:py-12 intersect:animate-fade-up animate-once animate-duration-[1500ms]">
  <div class="max-w-full md:max-w-3xl mx-auto px-4 md:px-0">
    <div class="mb-4">
      <div class="mb-2 flex items-center justify-between gap-4">
        <h2 class="font-heading uppercase tracking-[0.3em] text-lg md:text-xl text-text">{sectionTitle}</h2>
        <span class="text-[10px] uppercase tracking-[0.35em] text-muted inline-block">Swipe</span>
      </div>
      <p class="max-w-full md:max-w-xl text-text leading-6 text-sm md:text-sm">{sectionText}</p>
    </div>

    <div class="relative rounded-[2rem] border border-border bg-surface p-4 md:p-5">
      <div class="mb-6">
        <p class="text-xs uppercase tracking-[0.35em] text-muted">Erfaring</p>
      </div>

      <div class="relative cv-timeline-wrapper" data-timeline-id={timelineId}>
        <button
          type="button"
          onclick={"document.getElementById('" + timelineId + "').scrollBy({ left: -260, behavior: 'smooth' })"}
          class="hidden md:inline-flex absolute left-0 top-1/2 z-10 -translate-y-1/2 h-10 w-10 items-center justify-center rounded-full border border-border bg-white text-text shadow-sm transition hover:bg-accent hover:text-white focus:outline-none focus:ring-2 focus:ring-accent"
          aria-label="Forrige ansættelse"
        >
          <span class="text-lg">‹</span>
        </button>

        <div
          id={timelineId}
          class="timeline-scroll flex gap-3 overflow-x-auto pb-4 scroll-smooth snap-x snap-mandatory touch-pan-x"
          style="touch-action: pan-x; -webkit-overflow-scrolling: touch;"
        >
          {items.map((item) => (
            <article class="flex-shrink-0 min-w-[96%] sm:min-w-[84%] md:min-w-[46%] lg:min-w-[30%] snap-center">
              <div class="flex flex-col items-center text-center">
                <div class="mb-3">
                  <p class="text-[10px] uppercase tracking-[0.35em] text-muted">{item.date}</p>
                  <p class="mt-2 text-base font-semibold text-text">{item.company}</p>
                </div>

                <div class="relative w-full px-2">
                  <div class="h-px w-full bg-border"></div>
                  <div class="absolute left-1/2 top-1/2 h-3 w-3 -translate-x-1/2 -translate-y-1/2 rounded-full bg-accent border-2 border-white shadow-lg"></div>
                </div>
              </div>

              <div class="mt-4 rounded-[2rem] border border-border bg-white p-4 min-h-[150px] shadow-sm">
                <p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-accent">{item.role}</p>
                <p class="mt-2 text-text leading-6 text-sm">{item.description}</p>
              </div>
            </article>
          ))}
        </div>

        <button
          type="button"
          onclick={"document.getElementById('" + timelineId + "').scrollBy({ left: 260, behavior: 'smooth' })"}
          class="hidden md:inline-flex absolute right-0 top-1/2 z-10 -translate-y-1/2 h-10 w-10 items-center justify-center rounded-full border border-border bg-white text-text shadow-sm transition hover:bg-accent hover:text-white focus:outline-none focus:ring-2 focus:ring-accent"
          aria-label="Næste ansættelse"
        >
          <span class="text-lg">›</span>
        </button>
      </div>
    </div>
  </div>
</section>
